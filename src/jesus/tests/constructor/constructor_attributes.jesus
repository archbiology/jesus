let there be Person:
    __alpha__(public name: text; public years: number):
    amen
amen

let there be ungodly Creature:
    __alpha__(public name: text; age: number; public kind: text):
        say "birth of {name} (age {age}, {kind})"
    amen
amen

create p = Person("Jubileu", 49)
say p name
say p years

create c = Creature("Dog", 3, "animal")
say c name
say c kind