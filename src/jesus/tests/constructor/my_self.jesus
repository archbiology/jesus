let there be Person:
    __alpha__(public name: text, public age: number):
    amen
    purpose celebrate(age: number) -> number:
        my age = age
        return my age
    amen
    purpose card() -> text:
        return "{I name} is {my age} years old"
    amen
    purpose like(thing: text) -> truth:
        return thing is "water"
    amen
    purpose weather(thing: text):
        if I like thing:
            say "I like {thing}"
        otherwise:
            say "I do not like {thing}"
        amen
    amen
amen

create p = Person("Adam", 930)
say p card
say p celebrate 50
say p card
p weather "water"
p weather "fire"