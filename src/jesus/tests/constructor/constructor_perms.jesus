let there be Person:
    __alpha__(public name: text, protected age: number, private secret: text):
    amen
    purpose card() -> text:
        return "{name}:{age}:{secret}"
    amen
amen

let there be ungodly Creature:
    __alpha__(public label: text, age: number, protected kind: text):
        say "blessed {label} ({kind})"
    amen
    purpose describe() -> text:
        return "a {kind} named {label}"
    amen
amen

create p = Person("Adam", 930, "hidden")
say p name
say p card

create c = Creature("Dog", 3, "animal")
say c label
say c describe