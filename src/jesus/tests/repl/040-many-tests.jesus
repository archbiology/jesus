let there be GrandSon from Son:
    create surname: text = "Isaacson"

    purpose praise():
        name = "Jacob"
        say "Bethel ({name} {surname}),"
    amen

    purpose who():
        say "I am Israel, previously named {name}."
    amen

    purpose generateJudah():
        say "Judah is my lion, and my name is {name}."
    amen
amen

