let there be Person:
    create name: text = "Adam"
    create wife: text = "Eve"
    create age: number = 930

    purpose bless(): amen
    propósito sejaUmaBenção(): amém
    purpose testing(text what): create var: text = "inside function" amen
    purpose testTheSpirits(text a_; number b): create reference: text = "1 John 4:1" amen
    purpose aToB(number a_; number b):
        say "a before"
        say a_
        create c: number = 1
        create d: number = a_
        say "b before"
        say b
        say "before update b"
        b = 99
        say "before update a"
        a_ = b
        say "a updated"
        say a_
        b = d
        say b
        say name
        name = "Adopted by Jesus Christ"
        say name
        c = d
        say c
        c = age
        say c
    amen
    purpose functionWithoutParams():
        say "I am inside functionWithoutParams"
    amen
amen
say wife
