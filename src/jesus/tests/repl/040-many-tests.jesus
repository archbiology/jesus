create isEven: truth = yes
repeat 10 times:
  isEven = not isEven
  limit = limit + 1
  if limit < 4:
    skip
  amen
  if isEven:
    say "Even: {limit}"
  otherwise:
    say "Odd:  {limit}"
  amen
amen
