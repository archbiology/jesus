let there be Person:
    __alpha__(public text first; public number years):
    amen
amen

create dup = Person(first='A', first='B')
say dup first
create unk = Person(evil=5)
say unk years
create pos = Person(first='A', 49)
say pos years
create miss = Person(first='John')
say miss years
create ok = Person(years=49, first='John')
say ok first
say ok years