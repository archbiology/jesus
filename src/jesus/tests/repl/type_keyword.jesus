type Positive: number > 0
create age: Positive = 2
say age
type Negative: number < 0
create debt: Negative = -5
say debt
type AtLeast: number >= 10
create score: AtLeast = 10
say score
type AtMost: number <= 5
create small: AtMost = 5
say small
type Greeting: text matches "(Hello|Hi)"
create hi: Greeting = "Hello"
say hi