let there be MultilineParams:
    __alpha__(public name: text;
        # multiline parameters
        public age: number
    ):
        say name
        say age
    amen

    purpose greet(
        x: number;
        y: number):
        say x
        say y
    amen
amen

create p = MultilineParams(
    'Jesus',
    # multiline arguments
    33
)
say p name
say p age
p greet 10, 20
