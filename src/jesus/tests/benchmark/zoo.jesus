# Benchmark: zoo.jesus
# Workload: sum < 10000000
# Adapted from: https://github.com/munificent/craftinginterpreters/blob/master/test/benchmark/zoo.lox

# C++:              0.014823 s
# PHP 8.3:          0.168236 s
# Clox:             0.249795 s
# Python 3.12.3:    0.444851 s
#
# Jesus benchmark history
#
# Milestones:
#   [2a29564] Step 85 — Initial interpreter benchmark
#   [c95f280] Step 92 — Slot-based variable addressing
#   [df42a1b] Step 99 — Optimizer suite: Constant folding,
#                       constant propagation, dead-code elimination,
#                       method inlining, and loop unrolling
#
# Results:
#   AST [2a29564]:  64.455000 s
#   AST [c95f280]:  16.646000 s
#   AST [df42a1b]:   0.120000 s
#
#   VM  [c95f280]:   0.843000 s
#   VM  [df42a1b]:   0.144000 s
#
#   VM [after improvements of dynamic cast, and others]:
#
#   JIT:
#
# Machine:
#   CPU: AMD Ryzen 7 5825U with Radeon Graphics
#   Cores: 8 physical / 16 logical
#   RAM: 32 GB
#   OS: Ubuntu 24.04.4 LTS

let there be Zoo:
    create aarvark: number = 1
    create baboon: number = 1
    create cat: number = 1
    create donkey: number = 1
    create elephant: number = 1
    create fox: number = 1

    purpose ant() -> number:
        return aarvark
    amen

    purpose banana() -> number:
        return baboon
    amen

    purpose tuna() -> number:
        return cat
    amen

    purpose hay() -> number:
        return donkey
    amen

    purpose grass() -> number:
        return elephant
    amen

    purpose mouse() -> number:
        return fox
    amen
amen

create zoo: Zoo = 1
create sum: number = 0

repeat while sum < 10000000:
    sum = sum + zoo ant + zoo banana  + zoo tuna  + zoo hay  + zoo grass  + zoo mouse
amen

say sum
