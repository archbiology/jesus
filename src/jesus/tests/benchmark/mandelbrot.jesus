let there be Mandelbrot:
    purpose mandelbrot(cx: number, cy: number) -> number:
        create x: number = 0.0
        create y: number = 0.0
        create i = 0

        repeat while i < 1000:
            create x2: number = x * x
            create y2: number = y * y

            if x2 + y2 > 4.0:
                return i
            amen

            y = 2.0 * x * y + cy
            x = x2 - y2 + cx
            i = i + 1
        amen

        return 1000
    amen


    purpose benchmark():
        create total: number = 0

        create width: number = 1200
        create height: number = 1200

        create y: number = 0
        repeat while y < height:
            create x: number = 0

            repeat while x < width:
                create cx: number = -2.0 + x * 3.0 / width
                create cy: number = -1.0 + y * 2.0 / height

                total = total + my mandelbrot cx, cy

                x = x + 1
            amen

            y = y + 1
        amen

        say total
    amen
amen

create m = Mandelbrot()
m benchmark
